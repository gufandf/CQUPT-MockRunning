<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只需要联网。刻意不申请任何定位权限。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务：手机揣兜里 11 分钟，进程不能被系统随手杀掉 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 流体云 / 实时活动：Android 16 的「可提升的常驻通知」要这条普通权限。
         ColorOS 16 的流体云就是读这套原生 API 把通知收成胶囊的，
         少了它就是一条普通通知，进不了胶囊。
         低版本系统不认识这条权限，会被自动忽略，不影响安装。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- CPU 锁：息屏后不让 CPU 睡过去，否则 sleep 会睡过头把整轮拖长 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 电池优化白名单：深度 Doze 会连 wake lock 一起忽略，只有进白名单才彻底 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusRun"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="author"
            android:value="@string/app_author" />
        <!-- 版本号由 Gradle 的 manifestPlaceholders 注入（来源 android-app/version.properties），
             不要在这里手写 —— 以前手写过，跟 build.gradle 各写一份，就漏同步过。 -->
        <meta-data
            android:name="version"
            android:value="${appVersion}" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 日志页：完整运行日志 -->
        <activity
            android:name=".LogActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/log_page"
            android:parentActivityName=".MainActivity" />

        <!-- 设置首页：只放分组入口（分层结构的第一层） -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity" />

        <!-- 设置二级页：一个 Activity + 七套布局，按 EXTRA_GROUP 选
             （账号与场地 / 跑步参数 / 成绩统计 / 使用教程 / 流体云 / 外观 / 关于） -->
        <activity
            android:name=".SettingsGroupActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".SettingsActivity" />

        <service
            android:name=".RunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 把提取脚本当文件分享出去（发到微信文件传输助手，电脑上直接打开） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
