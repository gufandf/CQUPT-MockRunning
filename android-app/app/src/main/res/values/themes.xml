<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 流体设计主题（浅色，API 24~26）。

         窗口底色是 @color/bg 纯色，页面根布局也用同一个色值，
         Activity 转场时不会露出中间那层色差。

         注意：android:windowLightNavigationBar 是 API 27 才有的属性，而本项目
         minSdk = 24。它被放在 values-v27/ 里，这里**不要**加回来 ——
         在 API 24~26 上设一个当时还不存在的框架属性，遇到自己定义了同名属性 ID
         的厂商 ROM 会冲突。 -->
    <style name="Theme.CampusRun" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/fg_dim</item>
        <!-- 状态栏取光场的起点色、导航栏取终点色：两条系统栏与渐变无缝接上，
             不再是一条突兀的色带（v1.9.0 修过一次色带，这次是换成渐变后的同一问题）。 -->
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <!-- windowLightStatusBar 是 API 23，minSdk 24 已经覆盖 -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/fg_dim</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
