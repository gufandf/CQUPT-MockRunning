<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 标签样式：复用 themes.xml 里的 Label，这里不重复定义 -->
    <style name="SubLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 区块标题：小字、加宽字距，像流体设计里的「分组标签」 -->
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/gap_screen</item>
        <item name="android:paddingTop">@dimen/gap_section</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/fg_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <!-- 玻璃卡片容器：24dp 圆角 + 半透明玻璃 + 顶部高光（见 @drawable/box） -->
    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/box</item>
        <item name="android:layout_marginStart">@dimen/gap_screen</item>
        <item name="android:layout_marginEnd">@dimen/gap_screen</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:padding">@dimen/gap_card</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- 输入框样式 InputField 已删：它是 @drawable/field 的唯一引用方，
         而 field 本身在教程页取消只读脚本框之后就没任何布局用了。
         留着这个 style 只会让「@drawable/field 找不到」变成编译错误 -->

    <!-- 分组卡片：一整组设置项共用一张 28dp 圆角实心面，行与行之间靠行内分割线 -->
    <style name="SettingsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_group</item>
        <item name="android:layout_marginStart">@dimen/gap_screen</item>
        <item name="android:layout_marginEnd">@dimen/gap_screen</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <!-- 设置首页的分组入口：一条可点的玻璃行（标题 + 当前取值 + ›） -->
    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/box</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:layout_marginStart">@dimen/gap_screen</item>
        <item name="android:layout_marginEnd">@dimen/gap_screen</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- 主按钮：胶囊形，accent → accent_deep 渐变 -->
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <!-- 32dp 是液体按钮的形变余量（上下各 16dp），胶囊本体仍是 52dp -->
        <item name="android:layout_height">84dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 次要按钮：胶囊形玻璃 -->
    <style name="SecondaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">78dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
