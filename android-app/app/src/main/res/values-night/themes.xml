<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色模式下状态栏用浅色前景（深色，API 24~26）。

         windowBackground 同样是纯色，换成了深色的那一组。
         同样地，android:windowLightNavigationBar 是 API 27 才有的属性，
         它在 values-night-v27/ 里；这一份供 API 24~26 的深色模式使用。 -->
    <style name="Theme.CampusRun" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/fg_dim</item>
        <!-- 状态栏取光场的起点色、导航栏取终点色：两条系统栏与渐变无缝接上，
             不再是一条突兀的色带（v1.9.0 修过一次色带，这次是换成渐变后的同一问题）。 -->
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>
</resources>
