<?xml version="1.0" encoding="utf-8"?>
<!--
  日志页：完整运行日志 + 导出。
  顶栏固定显示「日志」和返回按钮，和设置页保持一致的导航。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ═══════════ 固定顶栏 ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <com.whale.campusrun.LiquidButton
            app:liquidTone="ghost"
            app:liquidIcon="@drawable/ic_back"
            app:liquidIconTint="@color/fg"
            app:liquidRoom="6dp"
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/log_page"
            android:textColor="@color/fg"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 分享 / 复制 / 清空收进液体弹出菜单：
             三个平铺按钮占掉一整行，而这些都是低频动作。 -->
        <com.whale.campusrun.LiquidButton
            app:liquidTone="ghost"
            android:id="@+id/btnMore"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:gravity="center"
            android:minWidth="72dp"
            android:text="@string/b_more"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/box"
            android:fillViewport="true"
            android:padding="12dp"
            android:scrollbarStyle="insideOverlay"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/log"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </ScrollView>

    </LinearLayout>
</LinearLayout>
