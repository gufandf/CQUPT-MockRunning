<?xml version="1.0" encoding="utf-8"?>
<!--
  时间轴上的一行成绩。

  左列是「竖线 + 圆点」：竖线贯穿整行，圆点对齐第一行文字。
  第一行的线从圆点往下画、最后一行的线到圆点为止 —— 由 renderStats 里设可见性。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:minHeight="64dp">

        <View
            android:id="@+id/tlLineTop"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="0dp"
            android:background="@color/row_divider" />

        <View
            android:id="@+id/tlDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="18dp"
            android:background="@drawable/dot_timeline" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTlTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/fg"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvTlSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/fg_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTlPace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/accent"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvTlBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:background="@drawable/chip_bg_on"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="@string/stats_latest"
        android:textColor="@color/on_accent"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
