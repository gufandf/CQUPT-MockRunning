<?xml version="1.0" encoding="utf-8"?>
<!--
    设置首页：只做「分层级」的那一层 —— 分组入口。

  参照 ColorOS 设置页：一整组是一张 28dp 圆角的实心卡片，卡片里一行一项，
  行右侧是当前取值 + 箭头，行间用细分割线分开。表单本身在二级页
  （SettingsGroupActivity + settings_group_*.xml）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/settings_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">
            <LinearLayout
                style="@style/SettingsGroup">

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowAccount"
                    app:rowTitle="@string/g_account"
                app:rowChevron="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowRun"
                    app:rowTitle="@string/g_run"
                app:rowChevron="true"
                app:rowDivider="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                style="@style/SettingsGroup">

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowStats"
                    app:rowTitle="@string/g_stats"
                app:rowChevron="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowTutorial"
                    app:rowTitle="@string/tutorial_title"
                app:rowChevron="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowLive"
                    app:rowTitle="@string/g_live"
                app:rowChevron="true"
                app:rowDivider="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                style="@style/SettingsGroup">

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowAppearance"
                    app:rowTitle="@string/g_appearance"
                app:rowChevron="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowAbout"
                    app:rowTitle="@string/g_about"
                app:rowChevron="true"
                app:rowDivider="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
