<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面：顶栏 + 地图 + 底部固定按钮。

  刻意做得很空 —— 主页只有「看进度」和「开始打卡」两件事。
  场地 / 配速 / 距离 / 抖动 / 统计 / 教程全部收进右上角【设置】。
  地图是自绘的 MapCanvasView，画边界、禁跑区和实时轨迹。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ═══════════ 顶栏：只留标题 + 两个图标 ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="11dp"
        android:paddingEnd="8dp"
        android:paddingBottom="9dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.02"
            android:text="@string/app_title"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnLog"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/log_page"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_log"
            android:tint="@color/fg" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            android:tint="@color/fg" />
    </LinearLayout>

    <!-- ═══════════ 地图：边界 / 禁跑区 / 实时轨迹 ═══════════ -->
    <com.whale.campusrun.MapCanvasView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1" />

    <!-- ═══════════ 底部：状态 + 固定按钮 ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/box"
            android:padding="10dp"
            android:text="@string/batt_unknown"
            android:textColor="@color/fg_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/box"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:text="@string/dash_idle"
            android:textColor="@color/fg"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/btn_solid"
            android:text="@string/b_run"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
