<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面：顶栏 + 地图 + 底部固定按钮。

  刻意做得很空 —— 主页只有「看进度」和「开始打卡」两件事。
  场地 / 配速 / 距离 / 抖动 / 统计 / 教程全部收进右上角【设置】。
  地图是自绘的 MapCanvasView，画边界、禁跑区和实时轨迹。

  视觉上是流体设计（ColorOS 16 那一套）：
    · 背景是纯色 @color/bg（不做渐变、不做模糊）
    · 顶栏透明，只有标题和两颗圆形玻璃图标
    · 所有卡片是 24dp 圆角的半透明玻璃，带顶部高光
    · 按钮是 LiquidButton：胶囊形 + accent → accent_deep 竖向渐变，
      按住拖动时形状会被拉成水滴，松手弹回（见 LiquidButton.kt）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ═══════════ 顶栏：透明，只留标题 + 两个玻璃图标 ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gap_screen"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.02"
            android:text="@string/app_title"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- 顶栏图标也用液体按钮：按下会缩、拖动会沿手指方向变形。
             尺寸里含形变余量，胶囊本体约 52dp 里的 44dp。 -->
        <com.whale.campusrun.LiquidButton
            app:liquidTone="ghost"
            app:liquidIcon="@drawable/ic_log"
            app:liquidIconTint="@color/fg"
            app:liquidRoom="6dp"
            android:id="@+id/btnLog"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/log_page" />

        <com.whale.campusrun.LiquidButton
            app:liquidTone="ghost"
            app:liquidIcon="@drawable/ic_settings"
            app:liquidIconTint="@color/fg"
            app:liquidRoom="6dp"
            android:id="@+id/btnSettings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/settings" />
    </LinearLayout>

    <!-- ═══════════ 地图：边界 / 禁跑区 / 实时轨迹 ═══════════
         外面套一层 FrameLayout，是为了让倒计时能**压在地图上**而不是把地图挤走。
         FrameLayout 里后画的在上面，所以 CountdownView 写在 MapCanvasView 之后。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/gap_screen"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/gap_screen"
        android:layout_weight="1">

        <com.whale.campusrun.MapCanvasView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 开跑前的 3 秒倒计时：点【开始打卡】后立刻出现，
             盖住「换 token / 拉场地 / 生成轨迹」那段没有反馈的空白。
             它默认 GONE，且不接收触摸 —— 不挡地图，也不挡下面的按钮。 -->
        <com.whale.campusrun.CountdownView
            android:id="@+id/countdown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ═══════════ 底部：状态 + 固定按钮 ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gap_screen"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/gap_screen"
        android:paddingBottom="20dp">

        <!-- 进度卡片：左边一个环（中间是百分比），右边竖排「剩余 / 已跑 / 配速」。
             文字并排堆在一起时看不出「还剩多少」，那才是用户真想知道的事。
             背景用 @drawable/card_status（纯色）而不是 bg 的 @drawable/box：
             这块全是数字，背景越平越好；box 的顶部高光在暗色下会显成一条亮带。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_status"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <com.whale.campusrun.RunProgressView
                android:id="@+id/ringProgress"
                android:layout_width="96dp"
                android:layout_height="96dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRemainLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dash_remain_label"
                    android:textColor="@color/fg_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRemain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dash_remain_idle"
                    android:textColor="@color/fg"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="@string/dash_dist_idle"
                    android:textColor="@color/fg"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/dash_pace_idle"
                    android:textColor="@color/fg_dim"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPhase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/dash_phase_idle"
                    android:textColor="@color/fg_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 主按钮：宽度直接吃满父容器的内边距，和上面的进度卡左右对齐。
             以前这里还加了 16dp 的 marginStart/End，加上父容器的 20dp，
             按钮左右各缩进 36dp，看上去比卡片窄一圈、像飘在中间。
             liquidRoom 是画布留给形变/发光的余量（胶囊本体 = 尺寸 − 2×余量），
             默认按高度 17.5%（92dp → 16dp）会再削掉一圈；这里显式收到 10dp。
             room 上下左右都算，所以高度同步从 92dp 收到 84dp ——
             胶囊本体仍是 64dp 左右，看起来是「同高、更宽」，而不是整颗被放大。 -->
        <com.whale.campusrun.LiquidButton
            app:liquidTone="accent"
            app:liquidRoom="10dp"
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:gravity="center"
            android:text="@string/b_run"
            android:textColor="@color/on_accent"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
