<?xml version="1.0" encoding="utf-8"?>
<!--
    二级页：账号与场地。

  一行一件事：openid 输入、取码说明、场地选择、连接。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/settings_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">
            <LinearLayout
                style="@style/SettingsGroup">

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowOpenid"
                    app:rowTitle="@string/l_openid_plain"
                    app:rowChevron="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowHelp"
                    app:rowTitle="@string/b_openid_help"
                app:rowChevron="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/panelOpenidHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/row_padding_h"
                    android:paddingTop="4dp"
                    android:paddingEnd="@dimen/row_padding_h"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/help_body"
                        android:textColor="@color/fg_dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowArea"
                    app:rowTitle="@string/l_area_plain"
                app:rowChevron="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowConnect"
                    app:rowTitle="@string/b_connect"
                app:rowAccent="true"
                app:rowDivider="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
