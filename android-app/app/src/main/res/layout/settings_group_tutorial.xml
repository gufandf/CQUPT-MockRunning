<?xml version="1.0" encoding="utf-8"?>
<!--
    二级页：使用教程。

  顶部一段正文，下面两行动作（复制 / 分享）。正文用卡片内边距块，
  不塞进 SettingsRow —— 行是「一项设置」，正文是一段说明。

  为什么去掉了「展开 / 收起脚本」：整段脚本源码摊在页面上既占地方又没人会在这里读，
  真要脚本时「复制 / 分享」已经够用了。省掉那一行和 220dp 的滚动区，
  页面只剩「读一遍说明 + 把脚本拿走」两件事。
  最后一个动作行的分割线要关掉 —— 卡片是 28dp 圆角，底部再多一条线会卡在弧线上。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/settings_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">
            <LinearLayout
                style="@style/SettingsGroup">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:paddingStart="@dimen/row_padding_h"
                    android:paddingTop="16dp"
                    android:paddingEnd="@dimen/row_padding_h"
                    android:paddingBottom="16dp"
                    android:text="@string/tutorial_body"
                    android:textColor="@color/fg_dim"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/row_padding_h"
                    android:background="@color/row_divider" />

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowCopyScript"
                    app:rowTitle="@string/b_copy_script"
                    app:rowAccent="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.whale.campusrun.SettingsRow
                    android:id="@+id/rowShareScript"
                    app:rowTitle="@string/b_share_script"
                    app:rowAccent="true"
                    app:rowDivider="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
