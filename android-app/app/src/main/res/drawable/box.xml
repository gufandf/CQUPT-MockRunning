<?xml version="1.0" encoding="utf-8"?>
<!--
  玻璃卡片底。

  三层叠出来：
    ① 半透明的玻璃面（@color/glass）—— 底下那层光场能透上来
    ② 顶部一道高光（glass_highlight → 透明），像玻璃边缘的折射
    ③ 1dp 描边（glass_stroke）把卡片从背景里「切」出来

  真正的背景模糊要 RenderEffect（API 31+）且代价不小，这里不做 ——
  半透明 + 高光已经足够读得出「玻璃」，也不必为老机器写兜底分支。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass" />
            <corners android:radius="@dimen/radius_card" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="@color/glass_highlight" />
        </shape>
    </item>
</layer-list>
