<?xml version="1.0" encoding="utf-8"?>
<!--
  主页「显示状态」卡片的底：**纯色**，不带高光渐变。

  为什么单独做一个，而不是复用 @drawable/box：
    box 的第二层是 glass_highlight → 透明的竖向渐变（模拟玻璃边缘折射）。
    那层在浅色下几乎看不出来（白玻璃上叠白高光），但暗色下玻璃是深色半透明，
    高光就显得很重 —— 一块卡片上半截明显比下半截亮，读起来像"漏光"，
    而不是一块干净的卡片。状态区里是百分比、剩余时间这些要看清的数字，
    背景越平越好。

  所以状态卡只保留：半透明玻璃面 + 1dp 描边，圆角与卡片一致。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass" />
    <corners android:radius="@dimen/radius_card" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
