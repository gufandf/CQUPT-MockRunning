<?xml version="1.0" encoding="utf-8"?>
<!--
  输入框底：浅一档的玻璃块 + 18dp 圆角。

  比卡片更「薄」—— 卡片 24dp、输入框 18dp，一眼能看出层级。
  以前这里直接复用 @drawable/box，输入框和卡片长得一模一样，边界很糊。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/field_bg" />
    <corners android:radius="@dimen/radius_inner" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
