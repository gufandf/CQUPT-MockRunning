*.jks

# ─────────── 真实轨迹（含学号 + 真实 GPS） ───────────
# refs/real_tracks/*.gpx 是本人真实跑步记录：文件名里带学号，内容是一整条真实
# GPS 轨迹。这两样都不能进仓库 —— 一旦推上去，"谁的学号、某天几点在哪个操场
# 跑了几圈"就永久留在 Git 历史里了。
# 标定用的统计结论已经写进 refs/track_gen.py 的注释，复现只需要自己再跑一遍。
refs/real_tracks/
# 手点的内轨迹同理：它是照着真实轨迹在图上点的，和真实轨迹位置一致
# （运行时那份在 android-app/app/src/main/assets/inner_rings.json，要提交）
refs/inner_rings.json

# ─────────── Python ───────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ─────────── 运行输出（每次跑都不一样）───────────
run/

# ─────────── 隐私：绝对不能进仓库 ───────────
# 这两个文件里有真实的 openid / 统一认证码 / 学号
refs/openid_extract.txt
refs/openid_hunt.txt
refs/*.flow
refs/wechat_cache/

# ─────────── 可按需重现的过程产物 ───────────
# 小程序解包结果，用 refs/wxapkg_unpack.py 随时能重现
refs/unpacked/
# 旧版手绘图标源图（已被插画版取代）
refs/icon/art/source_1024_old.png
# 各密度图标在 android-app/ 里已有一份，这里是重复的
refs/icon/mipmap-*/

# ─────────── 系统 ───────────
.DS_Store
Thumbs.db
desktop.ini
